--[[
    ================================================================
    CLASSICO UI LIBRARY - Classic Horror / Glossy 8K Theme
    Target: Roblox Luau (Client Script)
    ================================================================
--]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local SoundService = game:GetService("SoundService")

local ClassicoLib = {}
ClassicoLib.__index = ClassicoLib

-- Dark Theme Palette (Classic Horror Aesthetic)
local Colors = {
    Background = Color3.fromRGB(15, 10, 12),
    Header = Color3.fromRGB(25, 12, 15),
    AccentGlow = Color3.fromRGB(180, 20, 30),
    AccentDark = Color3.fromRGB(90, 10, 15),
    TopBevel = Color3.fromRGB(230, 40, 50),
    BottomBevel = Color3.fromRGB(40, 5, 8),
    TextPrimary = Color3.fromRGB(240, 220, 220),
    TextInactive = Color3.fromRGB(130, 100, 105),
    CardBg = Color3.fromRGB(22, 14, 17),
    InputBg = Color3.fromRGB(8, 5, 6)
}

local FONTS = {
    Title = Enum.Font.Creepster,
    Body = Enum.Font.SourceSansBold
}

-- UI Sound Effects
local function PlaySound(id, pitch, volume)
    task.spawn(function()
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://" .. tostring(id)
        sound.Pitch = pitch or 1
        sound.Volume = volume or 0.4
        sound.Parent = SoundService
        sound:Play()
        sound.Ended:Connect(function()
            sound:Destroy()
        end)
    end)
end

local function ApplyBevel(frame)
    local UIStroke = Instance.new("UIStroke")
    UIStroke.Thickness = 1.5
    UIStroke.Color = Colors.TopBevel
    UIStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    UIStroke.Parent = frame
    return UIStroke
end

-- Play Animated Intro Sequence
function ClassicoLib:PlayIntro(onComplete)
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "ClassicoIntro"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = CoreGui

    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, 0, 1, 0)
    Container.BackgroundColor3 = Color3.fromRGB(5, 2, 3)
    Container.BackgroundTransparency = 0
    Container.Parent = ScreenGui

    local Logo = Instance.new("TextLabel")
    Logo.Text = "CLASSICO"
    Logo.Font = FONTS.Title
    Logo.TextSize = 10
    Logo.TextColor3 = Colors.AccentGlow
    Logo.TextTransparency = 1
    Logo.AnchorPoint = Vector2.new(0.5, 0.5)
    Logo.Position = UDim2.new(0.5, 0, 0.5, 0)
    Logo.Size = UDim2.new(0, 300, 0, 100)
    Logo.BackgroundTransparency = 1
    Logo.Rotation = -180
    Logo.Parent = Container

    local Glow = Instance.new("ImageLabel")
    Glow.Image = "rbxassetid://134674955517480"
    Glow.Size = UDim2.new(0, 400, 0, 400)
    Glow.AnchorPoint = Vector2.new(0.5, 0.5)
    Glow.Position = UDim2.new(0.5, 0, 0.5, 0)
    Glow.ImageTransparency = 1
    Glow.BackgroundTransparency = 1
    Glow.Parent = Container

    PlaySound(9114223179, 0.8, 0.6)

    local tweenInfo = TweenInfo.new(1.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    TweenService:Create(Logo, tweenInfo, {TextSize = 68, TextTransparency = 0, Rotation = 0}):Play()
    TweenService:Create(Glow, tweenInfo, {ImageTransparency = 0.3}):Play()

    task.wait(1.5)

    local fadeInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    local fadeLogo = TweenService:Create(Logo, fadeInfo, {TextTransparency = 1, TextSize = 90})
    TweenService:Create(Container, fadeInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(Glow, fadeInfo, {ImageTransparency = 1}):Play()
    
    fadeLogo:Play()
    fadeLogo.Completed:Connect(function()
        ScreenGui:Destroy()
        if onComplete then onComplete() end
    end)
end

-- Send Toast Notification
function ClassicoLib:Notify(opts)
    opts = opts or {}
    local title = opts.Title or "Notification"
    local desc = opts.Description or ""
    local duration = opts.Duration or 4

    local NotifyGui = CoreGui:FindFirstChild("ClassicoNotifyGui")
    if not NotifyGui then
        NotifyGui = Instance.new("ScreenGui")
        NotifyGui.Name = "ClassicoNotifyGui"
        NotifyGui.Parent = CoreGui
    end

    local Holder = NotifyGui:FindFirstChild("Holder")
    if not Holder then
        Holder = Instance.new("Frame")
        Holder.Name = "Holder"
        Holder.Size = UDim2.new(0, 260, 1, -20)
        Holder.Position = UDim2.new(1, -270, 0, 10)
        Holder.BackgroundTransparency = 1
        Holder.Parent = NotifyGui

        local Layout = Instance.new("UIListLayout")
        Layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
        Layout.Padding = UDim.new(0, 8)
        Layout.Parent = Holder
    end

    PlaySound(6026982028, 1.2, 0.3)

    local Card = Instance.new("Frame")
    Card.Size = UDim2.new(1, 0, 0, 65)
    Card.BackgroundColor3 = Colors.CardBg
    Card.BorderSizePixel = 0
    Card.Parent = Holder

    ApplyBevel(Card)

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Text = title
    TitleLabel.Font = FONTS.Title
    TitleLabel.TextSize = 18
    TitleLabel.TextColor3 = Colors.AccentGlow
    TitleLabel.Position = UDim2.new(0, 10, 0, 6)
    TitleLabel.Size = UDim2.new(1, -20, 0, 20)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.Parent = Card

    local DescLabel = Instance.new("TextLabel")
    DescLabel.Text = desc
    DescLabel.Font = FONTS.Body
    DescLabel.TextSize = 13
    DescLabel.TextColor3 = Colors.TextPrimary
    DescLabel.Position = UDim2.new(0, 10, 0, 28)
    DescLabel.Size = UDim2.new(1, -20, 0, 30)
    DescLabel.BackgroundTransparency = 1
    DescLabel.TextWrapped = true
    DescLabel.TextXAlignment = Enum.TextXAlignment.Left
    DescLabel.Parent = Card

    Card.Position = UDim2.new(1, 300, 0, 0)
    TweenService:Create(Card, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()

    task.delay(duration, function()
        local tweenOut = TweenService:Create(Card, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(1, 0, 0, 0)})
        tweenOut:Play()
        tweenOut.Completed:Connect(function()
            Card:Destroy()
        end)
    end)
end

-- Create Main Window
function ClassicoLib:CreateWindow(config)
    config = config or {}
    local windowTitle = config.Title or "MOONDRATSY HUB"
    local windowSub = config.SubTitle or "Classic Roblox Script"
    local windowSize = config.Size or UDim2.new(0, 586, 0, 350)

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "ClassicoUIWindow"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = CoreGui

    -- Main Container
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = windowSize
    MainFrame.Position = UDim2.new(0.5, -windowSize.X.Offset / 2, 0.5, -windowSize.Y.Offset / 2)
    MainFrame.BackgroundColor3 = Colors.Background
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = ScreenGui

    ApplyBevel(MainFrame)

    -- Background Gloss Glow Image (ID: 134674955517480)
    local BackgroundGlow = Instance.new("ImageLabel")
    BackgroundGlow.Name = "GlossBackground"
    BackgroundGlow.Image = "rbxassetid://134674955517480"
    BackgroundGlow.Size = UDim2.new(1, 0, 1, 0)
    BackgroundGlow.ImageTransparency = 0.65
    BackgroundGlow.BackgroundTransparency = 1
    BackgroundGlow.ScaleType = Enum.ScaleType.Crop
    BackgroundGlow.Parent = MainFrame

    -- Header Frame
    local Header = Instance.new("Frame")
    Header.Name = "Header"
    Header.Size = UDim2.new(1, 0, 0, 50)
    Header.BackgroundColor3 = Colors.Header
    Header.BorderSizePixel = 0
    Header.Parent = MainFrame

    local HeaderTitle = Instance.new("TextLabel")
    HeaderTitle.Text = windowTitle
    HeaderTitle.Font = FONTS.Title
    HeaderTitle.TextSize = 24
    HeaderTitle.TextColor3 = Colors.AccentGlow
    HeaderTitle.Position = UDim2.new(0, 15, 0, 5)
    HeaderTitle.Size = UDim2.new(0, 300, 0, 25)
    HeaderTitle.BackgroundTransparency = 1
    HeaderTitle.TextXAlignment = Enum.TextXAlignment.Left
    HeaderTitle.Parent = Header

    local HeaderSub = Instance.new("TextLabel")
    HeaderSub.Text = windowSub
    HeaderSub.Font = FONTS.Body
    HeaderSub.TextSize = 12
    HeaderSub.TextColor3 = Colors.TextInactive
    HeaderSub.Position = UDim2.new(0, 15, 0, 28)
    HeaderSub.Size = UDim2.new(0, 300, 0, 15)
    HeaderSub.BackgroundTransparency = 1
    HeaderSub.TextXAlignment = Enum.TextXAlignment.Left
    HeaderSub.Parent = Header

    -- Dragging Mechanics
    local dragging, dragInput, dragStart, startPos
    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    Header.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Window Controls
    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Text = "X"
    CloseBtn.Font = FONTS.Title
    CloseBtn.TextSize = 18
    CloseBtn.TextColor3 = Colors.TextPrimary
    CloseBtn.Size = UDim2.new(0, 30, 0, 30)
    CloseBtn.Position = UDim2.new(1, -38, 0, 10)
    CloseBtn.BackgroundColor3 = Colors.AccentDark
    CloseBtn.Parent = Header
    ApplyBevel(CloseBtn)

    local MinimizeBtn = Instance.new("TextButton")
    MinimizeBtn.Text = "-"
    MinimizeBtn.Font = FONTS.Title
    MinimizeBtn.TextSize = 22
    MinimizeBtn.TextColor3 = Colors.TextPrimary
    MinimizeBtn.Size = UDim2.new(0, 30, 0, 30)
    MinimizeBtn.Position = UDim2.new(1, -74, 0, 10)
    MinimizeBtn.BackgroundColor3 = Colors.CardBg
    MinimizeBtn.Parent = Header
    ApplyBevel(MinimizeBtn)

    local isMinimized = false
    MinimizeBtn.MouseButton1Click:Connect(function()
        PlaySound(12221967, 1, 0.3)
        isMinimized = not isMinimized
        TweenService:Create(MainFrame, TweenInfo.new(0.3), {Size = isMinimized and UDim2.new(windowSize.X.Scale, windowSize.X.Offset, 0, 50) or windowSize}):Play()
    end)

    -- Confirmation Close Modal
    local ConfirmDialog = Instance.new("Frame")
    ConfirmDialog.Size = UDim2.new(1, 0, 1, 0)
    ConfirmDialog.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    ConfirmDialog.BackgroundTransparency = 0.4
    ConfirmDialog.Visible = false
    ConfirmDialog.ZIndex = 10
    ConfirmDialog.Parent = MainFrame

    local Modal = Instance.new("Frame")
    Modal.Size = UDim2.new(0, 280, 0, 140)
    Modal.Position = UDim2.new(0.5, -140, 0.5, -70)
    Modal.BackgroundColor3 = Colors.CardBg
    Modal.ZIndex = 11
    Modal.Parent = ConfirmDialog
    ApplyBevel(Modal)

    local ModalText = Instance.new("TextLabel")
    ModalText.Text = "Are you sure you want to close?"
    ModalText.Font = FONTS.Title
    ModalText.TextSize = 18
    ModalText.TextColor3 = Colors.TextPrimary
    ModalText.Size = UDim2.new(1, -20, 0, 50)
    ModalText.Position = UDim2.new(0, 10, 0, 15)
    ModalText.BackgroundTransparency = 1
    ModalText.TextWrapped = true
    ModalText.ZIndex = 12
    ModalText.Parent = Modal

    local YesBtn = Instance.new("TextButton")
    YesBtn.Text = "YES"
    YesBtn.Font = FONTS.Title
    YesBtn.TextSize = 16
    YesBtn.TextColor3 = Colors.TextPrimary
    YesBtn.BackgroundColor3 = Colors.AccentDark
    YesBtn.Size = UDim2.new(0, 100, 0, 35)
    YesBtn.Position = UDim2.new(0, 25, 1, -45)
    YesBtn.ZIndex = 12
    YesBtn.Parent = Modal
    ApplyBevel(YesBtn)

    local NoBtn = Instance.new("TextButton")
    NoBtn.Text = "NO"
    NoBtn.Font = FONTS.Title
    NoBtn.TextSize = 16
    NoBtn.TextColor3 = Colors.TextPrimary
    NoBtn.BackgroundColor3 = Colors.CardBg
    NoBtn.Size = UDim2.new(0, 100, 0, 35)
    NoBtn.Position = UDim2.new(1, -125, 1, -45)
    NoBtn.ZIndex = 12
    NoBtn.Parent = Modal
    ApplyBevel(NoBtn)

    CloseBtn.MouseButton1Click:Connect(function()
        PlaySound(12221967, 1, 0.3)
        ConfirmDialog.Visible = true
    end)

    YesBtn.MouseButton1Click:Connect(function()
        PlaySound(12221967, 0.8, 0.3)
        ScreenGui:Destroy()
    end)

    NoBtn.MouseButton1Click:Connect(function()
        PlaySound(12221967, 1, 0.3)
        ConfirmDialog.Visible = false
    end)

    -- Tab System Bar
    local TabBar = Instance.new("ScrollingFrame")
    TabBar.Name = "TabBar"
    TabBar.Size = UDim2.new(1, -20, 0, 35)
    TabBar.Position = UDim2.new(0, 10, 0, 55)
    TabBar.BackgroundTransparency = 1
    TabBar.CanvasSize = UDim2.new(0, 0, 0, 0)
    TabBar.ScrollBarThickness = 2
    TabBar.ScrollBarImageColor3 = Colors.AccentGlow
    TabBar.ScrollingDirection = Enum.ScrollingDirection.Horizontal
    TabBar.Parent = MainFrame

    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.FillDirection = Enum.FillDirection.Horizontal
    TabListLayout.Padding = UDim.new(0, 6)
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.Parent = TabBar

    TabListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        TabBar.CanvasSize = UDim2.new(0, TabListLayout.AbsoluteContentSize.X, 0, 0)
    end)

    -- Container for Tab Content Pages
    local PageContainer = Instance.new("Frame")
    PageContainer.Name = "PageContainer"
    PageContainer.Size = UDim2.new(1, -20, 1, -100)
    PageContainer.Position = UDim2.new(0, 10, 0, 95)
    PageContainer.BackgroundTransparency = 1
    PageContainer.Parent = MainFrame

    local WindowObj = {
        Tabs = {},
        ActiveTab = nil
    }

    -- Run Entrance Sequence
    ClassicoLib:PlayIntro()

    -- Tab Instantiation Engine
    function WindowObj:CreateTab(tabName)
        local TabBtn = Instance.new("TextButton")
        TabBtn.Text = tabName
        TabBtn.Font = FONTS.Title
        TabBtn.TextSize = 16
        TabBtn.TextColor3 = Colors.TextInactive
        TabBtn.BackgroundColor3 = Colors.CardBg
        TabBtn.Size = UDim2.new(0, 100, 1, -4)
        TabBtn.Parent = TabBar
        ApplyBevel(TabBtn)

        local Page = Instance.new("ScrollingFrame")
        Page.Name = tabName .. "Page"
        Page.Size = UDim2.new(1, 0, 1, 0)
        Page.BackgroundTransparency = 1
        Page.ScrollBarThickness = 4
        Page.ScrollBarImageColor3 = Colors.AccentGlow
        Page.Visible = false
        Page.Parent = PageContainer

        local PageLayout = Instance.new("UIListLayout")
        PageLayout.Padding = UDim.new(0, 8)
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageLayout.Parent = Page

        PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Page.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 10)
        end)

        local function SwitchTab()
            PlaySound(12221967, 1.1, 0.2)
            for _, t in pairs(WindowObj.Tabs) do
                t.Button.BackgroundColor3 = Colors.CardBg
                t.Button.TextColor3 = Colors.TextInactive
                t.Page.Visible = false
            end
            TabBtn.BackgroundColor3 = Colors.AccentDark
            TabBtn.TextColor3 = Colors.TextPrimary
            Page.Visible = true
            WindowObj.ActiveTab = Page
        end

        TabBtn.MouseButton1Click:Connect(SwitchTab)

        if #WindowObj.Tabs == 0 then
            SwitchTab()
        end

        local TabElements = {}

        -- Element 1: Button
        function TabElements:CreateButton(name, callback)
            callback = callback or function() end
            local Btn = Instance.new("TextButton")
            Btn.Text = name
            Btn.Font = FONTS.Title
            Btn.TextSize = 16
            Btn.TextColor3 = Colors.TextPrimary
            Btn.BackgroundColor3 = Colors.CardBg
            Btn.Size = UDim2.new(1, -6, 0, 36)
            Btn.Parent = Page
            ApplyBevel(Btn)

            Btn.MouseButton1Click:Connect(function()
                PlaySound(12221967, 1, 0.4)
                TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Colors.AccentDark}):Play()
                task.wait(0.1)
                TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Colors.CardBg}):Play()
                pcall(callback)
            end)
        end

        -- Element 2: Toggle
        function TabElements:CreateToggle(name, callback)
            callback = callback or function() end
            local enabled = false

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -6, 0, 36)
            Frame.BackgroundColor3 = Colors.CardBg
            Frame.Parent = Page
            ApplyBevel(Frame)

            local Label = Instance.new("TextLabel")
            Label.Text = name
            Label.Font = FONTS.Body
            Label.TextSize = 14
            Label.TextColor3 = Colors.TextPrimary
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.Size = UDim2.new(0.7, 0, 1, 0)
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame

            local Switch = Instance.new("TextButton")
            Switch.Text = "OFF"
            Switch.Font = FONTS.Title
            Switch.TextSize = 14
            Switch.TextColor3 = Colors.TextInactive
            Switch.BackgroundColor3 = Colors.InputBg
            Switch.Size = UDim2.new(0, 60, 0, 24)
            Switch.Position = UDim2.new(1, -70, 0.5, -12)
            Switch.Parent = Frame
            ApplyBevel(Switch)

            Switch.MouseButton1Click:Connect(function()
                enabled = not enabled
                PlaySound(12221967, enabled and 1.2 or 0.9, 0.3)
                Switch.Text = enabled and "ON" or "OFF"
                Switch.TextColor3 = enabled and Colors.TextPrimary or Colors.TextInactive
                TweenService:Create(Switch, TweenInfo.new(0.2), {BackgroundColor3 = enabled and Colors.AccentGlow or Colors.InputBg}):Play()
                pcall(callback, enabled)
            end)
        end

        -- Element 3: Slider
        function TabElements:CreateSlider(name, min, max, default, callback)
            callback = callback or function() end
            min = min or 0
            max = max or 100
            default = math.clamp(default or min, min, max)

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -6, 0, 48)
            Frame.BackgroundColor3 = Colors.CardBg
            Frame.Parent = Page
            ApplyBevel(Frame)

            local Label = Instance.new("TextLabel")
            Label.Text = name
            Label.Font = FONTS.Body
            Label.TextSize = 14
            Label.TextColor3 = Colors.TextPrimary
            Label.Position = UDim2.new(0, 10, 0, 4)
            Label.Size = UDim2.new(0.6, 0, 0, 20)
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame

            local ValLabel = Instance.new("TextLabel")
            ValLabel.Text = tostring(default)
            ValLabel.Font = FONTS.Body
            ValLabel.TextSize = 14
            ValLabel.TextColor3 = Colors.AccentGlow
            ValLabel.Position = UDim2.new(1, -70, 0, 4)
            ValLabel.Size = UDim2.new(0, 60, 0, 20)
            ValLabel.BackgroundTransparency = 1
            ValLabel.TextXAlignment = Enum.TextXAlignment.Right
            ValLabel.Parent = Frame

            local Track = Instance.new("Frame")
            Track.Size = UDim2.new(1, -20, 0, 10)
            Track.Position = UDim2.new(0, 10, 0, 28)
            Track.BackgroundColor3 = Colors.InputBg
            Track.Parent = Frame
            ApplyBevel(Track)

            local Fill = Instance.new("Frame")
            Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
            Fill.BackgroundColor3 = Colors.AccentGlow
            Fill.BorderSizePixel = 0
            Fill.Parent = Track

            local sliding = false

            local function UpdateSlide(input)
                local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                local val = math.floor(min + ((max - min) * pos))
                Fill.Size = UDim2.new(pos, 0, 1, 0)
                ValLabel.Text = tostring(val)
                pcall(callback, val)
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    UpdateSlide(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlide(input)
                end
            end)
        end

        -- Element 4: Dropdown
        function TabElements:CreateDropdown(name, options, callback)
            options = options or {}
            callback = callback or function() end
            local expanded = false

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -6, 0, 36)
            Frame.BackgroundColor3 = Colors.CardBg
            Frame.ClipsDescendants = true
            Frame.Parent = Page
            ApplyBevel(Frame)

            local MainBtn = Instance.new("TextButton")
            MainBtn.Text = name .. " :"
            MainBtn.Font = FONTS.Body
            MainBtn.TextSize = 14
            MainBtn.TextColor3 = Colors.TextPrimary
            MainBtn.Size = UDim2.new(1, 0, 0, 36)
            MainBtn.BackgroundTransparency = 1
            MainBtn.TextXAlignment = Enum.TextXAlignment.Left
            MainBtn.Position = UDim2.new(0, 10, 0, 0)
            MainBtn.Parent = Frame

            local ListLayout = Instance.new("UIListLayout")
            ListLayout.Padding = UDim.new(0, 2)
            ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
            ListLayout.Parent = Frame

            MainBtn.MouseButton1Click:Connect(function()
                PlaySound(12221967, 1, 0.2)
                expanded = not expanded
                local targetHeight = expanded and (38 + (#options * 28)) or 36
                TweenService:Create(Frame, TweenInfo.new(0.25), {Size = UDim2.new(1, -6, 0, targetHeight)}):Play()
            end)

            for _, opt in ipairs(options) do
                local OptBtn = Instance.new("TextButton")
                OptBtn.Text = tostring(opt)
                OptBtn.Font = FONTS.Body
                OptBtn.TextSize = 13
                OptBtn.TextColor3 = Colors.TextInactive
                OptBtn.BackgroundColor3 = Colors.InputBg
                OptBtn.Size = UDim2.new(1, -20, 0, 26)
                OptBtn.Position = UDim2.new(0, 10, 0, 0)
                OptBtn.Parent = Frame

                OptBtn.MouseButton1Click:Connect(function()
                    PlaySound(12221967, 1.1, 0.3)
                    MainBtn.Text = name .. " : " .. tostring(opt)
                    expanded = false
                    TweenService:Create(Frame, TweenInfo.new(0.2), {Size = UDim2.new(1, -6, 0, 36)}):Play()
                    pcall(callback, opt)
                end)
            end
        end

        -- Element 5: TextBox
        function TabElements:CreateTextBox(name, placeholder, callback)
            callback = callback or function() end

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, -6, 0, 36)
            Frame.BackgroundColor3 = Colors.CardBg
            Frame.Parent = Page
            ApplyBevel(Frame)

            local Label = Instance.new("TextLabel")
            Label.Text = name
            Label.Font = FONTS.Body
            Label.TextSize = 14
            Label.TextColor3 = Colors.TextPrimary
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.Size = UDim2.new(0.4, 0, 1, 0)
            Label.BackgroundTransparency = 1
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Frame

            local Box = Instance.new("TextBox")
            Box.PlaceholderText = placeholder or "Type here..."
            Box.Text = ""
            Box.Font = FONTS.Body
            Box.TextSize = 13
            Box.TextColor3 = Colors.TextPrimary
            Box.PlaceholderColor3 = Colors.TextInactive
            Box.BackgroundColor3 = Colors.InputBg
            Box.Size = UDim2.new(0.55, -10, 0, 24)
            Box.Position = UDim2.new(0.45, 0, 0.5, -12)
            Box.Parent = Frame
            ApplyBevel(Box)

            Box.FocusLost:Connect(function(enterPressed)
                pcall(callback, Box.Text, enterPressed)
            end)
        end

        table.insert(WindowObj.Tabs, {Button = TabBtn, Page = Page})
        return TabElements
    end

    return WindowObj
end

return ClassicoLib
 
