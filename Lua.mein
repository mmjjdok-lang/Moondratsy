--==================================================
-- CLASSICO UI LIBRARY - Classic Horror / Glossy 8K
-- Theme: Dark Red, Bevel Effects, Horror Aesthetics
--==================================================

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local SoundService = game:GetService("SoundService")

local ClassicoLib = {}
ClassicoLib.__index = ClassicoLib

-- Helper: Create Sound
local function PlaySound(soundId, pitch)
	local sound = Instance.new("Sound")
	sound.SoundId = soundId or "rbxassetid://6042053626"
	sound.Pitch = pitch or 1
	sound.Volume = 0.5
	sound.Parent = SoundService
	sound:Play()
	sound.Ended:Connect(function() sound:Destroy() end)
end

-- Intro Animation ("CLASSICO")
local function RunIntro()
	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "ClassicoIntro"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.Parent = CoreGui

	local IntroText = Instance.new("TextLabel")
	IntroText.Size = UDim2.new(0, 300, 0, 100)
	IntroText.Position = UDim2.new(0.5, -150, 0.5, -50)
	IntroText.BackgroundTransparency = 1
	IntroText.Text = "CLASSICO"
	IntroText.Font = Enum.Font.Creepster
	IntroText.TextSize = 10
	IntroText.TextColor3 = Color3.fromRGB(180, 0, 0)
	IntroText.TextTransparency = 1
	IntroText.Rotation = -180
	IntroText.Parent = ScreenGui

	local tweenInfo = TweenInfo.new(1.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local tweenGrow = TweenService:Create(IntroText, tweenInfo, {
		TextSize = 75,
		TextTransparency = 0,
		Rotation = 0
	})

	tweenGrow:Play()
	tweenGrow.Completed:Wait()
	task.wait(0.5)

	local tweenFade = TweenService:Create(IntroText, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		TextTransparency = 1,
		TextSize = 110
	})
	tweenFade:Play()
	tweenFade.Completed:Wait()

	ScreenGui:Destroy()
end

-- Notification System
function ClassicoLib:Notify(title, text, duration)
	duration = duration or 3
	PlaySound("rbxassetid://9118823101", 1.2)

	local NotifGui = CoreGui:FindFirstChild("ClassicoNotifications")
	if not NotifGui then
		NotifGui = Instance.new("ScreenGui")
		NotifGui.Name = "ClassicoNotifications"
		NotifGui.Parent = CoreGui
		
		local Holder = Instance.new("Frame")
		Holder.Name = "Holder"
		Holder.Size = UDim2.new(0, 250, 1, -20)
		Holder.Position = UDim2.new(1, -260, 0, 10)
		Holder.BackgroundTransparency = 1
		Holder.Parent = NotifGui

		local Layout = Instance.new("UIListLayout")
		Layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
		Layout.Padding = UDim.new(0, 8)
		Layout.Parent = Holder
	end

	local Card = Instance.new("Frame")
	Card.Size = UDim2.new(1, 0, 0, 65)
	Card.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	Card.BorderSizePixel = 0
	Card.BackgroundTransparency = 1
	Card.Parent = NotifGui.Holder

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = Color3.fromRGB(180, 0, 0)
	Stroke.Thickness = 1.5
	Stroke.Transparency = 1
	Stroke.Parent = Card

	local TitleLbl = Instance.new("TextLabel")
	TitleLbl.Size = UDim2.new(1, -10, 0, 22)
	TitleLbl.Position = UDim2.new(0, 8, 0, 4)
	TitleLbl.BackgroundTransparency = 1
	TitleLbl.Text = title
	TitleLbl.Font = Enum.Font.Creepster
	TitleLbl.TextSize = 18
	TitleLbl.TextColor3 = Color3.fromRGB(220, 20, 20)
	TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
	TitleLbl.TextTransparency = 1
	TitleLbl.Parent = Card

	local TextLbl = Instance.new("TextLabel")
	TextLbl.Size = UDim2.new(1, -16, 0, 32)
	TextLbl.Position = UDim2.new(0, 8, 0, 26)
	TextLbl.BackgroundTransparency = 1
	TextLbl.Text = text
	TextLbl.Font = Enum.Font.SourceSans
	TextLbl.TextSize = 14
	TextLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
	TextLbl.TextWrapped = true
	TextLbl.TextXAlignment = Enum.TextXAlignment.Left
	TextLbl.TextTransparency = 1
	TextLbl.Parent = Card

	-- Fade In
	TweenService:Create(Card, TweenInfo.new(0.3), {BackgroundTransparency = 0.1}):Play()
	TweenService:Create(Stroke, TweenInfo.new(0.3), {Transparency = 0}):Play()
	TweenService:Create(TitleLbl, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
	TweenService:Create(TextLbl, TweenInfo.new(0.3), {TextTransparency = 0}):Play()

	task.delay(duration, function()
		local fadeOut = TweenService:Create(Card, TweenInfo.new(0.4), {BackgroundTransparency = 1})
		TweenService:Create(Stroke, TweenInfo.new(0.4), {Transparency = 1}):Play()
		TweenService:Create(TitleLbl, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
		TweenService:Create(TextLbl, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
		fadeOut:Play()
		fadeOut.Completed:Connect(function() Card:Destroy() end)
	end)
end

-- Create Window
function ClassicoLib:CreateWindow(config)
	RunIntro()

	local Window = {}
	local TitleText = config.Title or "MOONDRATSY HUB"
	local SubTitleText = config.SubTitle or "Classic Roblox Script"
	local WindowSize = config.Size or UDim2.new(0, 586, 0, 350)

	-- ScreenGui Setup
	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "ClassicoHubGui"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.Parent = CoreGui

	-- Main Outer Container (Glass Glow Frame)
	local MainFrame = Instance.new("Frame")
	MainFrame.Name = "MainFrame"
	MainFrame.Size = WindowSize
	MainFrame.Position = UDim2.new(0.5, -WindowSize.X.Offset/2, 0.5, -WindowSize.Y.Offset/2)
	MainFrame.BackgroundColor3 = Color3.fromRGB(10, 5, 5)
	MainFrame.BorderSizePixel = 0
	MainFrame.Active = true
	MainFrame.ClipsDescendants = false
	MainFrame.Parent = ScreenGui

	-- Gloss Glow Glow Outer Stroke
	local OuterGlow = Instance.new("UIStroke")
	OuterGlow.Color = Color3.fromRGB(150, 0, 0)
	OuterGlow.Thickness = 2
	OuterGlow.Parent = MainFrame

	-- Bevel Effects (Light Top-Left, Dark Bottom-Right)
	local BevelTopLeft = Instance.new("Frame")
	BevelTopLeft.Size = UDim2.new(1, 0, 0, 2)
	BevelTopLeft.BackgroundColor3 = Color3.fromRGB(230, 40, 40)
	BevelTopLeft.BorderSizePixel = 0
	BevelTopLeft.Parent = MainFrame

	local BevelLeft = Instance.new("Frame")
	BevelLeft.Size = UDim2.new(0, 2, 1, 0)
	BevelLeft.BackgroundColor3 = Color3.fromRGB(230, 40, 40)
	BevelLeft.BorderSizePixel = 0
	BevelLeft.Parent = MainFrame

	local BevelBottomRight = Instance.new("Frame")
	BevelBottomRight.Size = UDim2.new(1, 0, 0, 2)
	BevelBottomRight.Position = UDim2.new(0, 0, 1, -2)
	BevelBottomRight.BackgroundColor3 = Color3.fromRGB(40, 0, 0)
	BevelBottomRight.BorderSizePixel = 0
	BevelBottomRight.Parent = MainFrame

	local BevelRight = Instance.new("Frame")
	BevelRight.Size = UDim2.new(0, 2, 1, 0)
	BevelRight.Position = UDim2.new(1, -2, 0, 0)
	BevelRight.BackgroundColor3 = Color3.fromRGB(40, 0, 0)
	BevelRight.BorderSizePixel = 0
	BevelRight.Parent = MainFrame

	-- Header Setup
	local Header = Instance.new("Frame")
	Header.Name = "Header"
	Header.Size = UDim2.new(1, 0, 0, 50)
	Header.BackgroundColor3 = Color3.fromRGB(20, 5, 5)
	Header.BorderSizePixel = 0
	Header.Parent = MainFrame

	local HeaderTitle = Instance.new("TextLabel")
	HeaderTitle.Size = UDim2.new(1, -100, 0, 28)
	HeaderTitle.Position = UDim2.new(0, 12, 0, 4)
	HeaderTitle.BackgroundTransparency = 1
	HeaderTitle.Text = TitleText
	HeaderTitle.Font = Enum.Font.Creepster
	HeaderTitle.TextSize = 24
	HeaderTitle.TextColor3 = Color3.fromRGB(220, 20, 20)
	HeaderTitle.TextXAlignment = Enum.TextXAlignment.Left
	HeaderTitle.Parent = Header

	local HeaderSub = Instance.new("TextLabel")
	HeaderSub.Size = UDim2.new(1, -100, 0, 16)
	HeaderSub.Position = UDim2.new(0, 12, 0, 28)
	HeaderSub.BackgroundTransparency = 1
	HeaderSub.Text = SubTitleText
	HeaderSub.Font = Enum.Font.SourceSansItalic
	HeaderSub.TextSize = 13
	HeaderSub.TextColor3 = Color3.fromRGB(150, 150, 150)
	HeaderSub.TextXAlignment = Enum.TextXAlignment.Left
	HeaderSub.Parent = Header

	-- Controls (Minimize / Close)
	local CloseBtn = Instance.new("TextButton")
	CloseBtn.Size = UDim2.new(0, 28, 0, 28)
	CloseBtn.Position = UDim2.new(1, -34, 0, 10)
	CloseBtn.BackgroundColor3 = Color3.fromRGB(60, 0, 0)
	CloseBtn.Text = "X"
	CloseBtn.Font = Enum.Font.Creepster
	CloseBtn.TextSize = 18
	CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	CloseBtn.BorderSizePixel = 0
	CloseBtn.Parent = Header

	local MinimizeBtn = Instance.new("TextButton")
	MinimizeBtn.Size = UDim2.new(0, 28, 0, 28)
	MinimizeBtn.Position = UDim2.new(1, -68, 0, 10)
	MinimizeBtn.BackgroundColor3 = Color3.fromRGB(40, 10, 10)
	MinimizeBtn.Text = "-"
	MinimizeBtn.Font = Enum.Font.SourceSansBold
	MinimizeBtn.TextSize = 22
	MinimizeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	MinimizeBtn.BorderSizePixel = 0
	MinimizeBtn.Parent = Header

	-- Window Dragging Implementation
	local dragging, dragInput, dragStart, startPos
	Header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = MainFrame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	Header.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)

	-- Confirm Close Dialog
	local ConfirmFrame = Instance.new("Frame")
	ConfirmFrame.Size = UDim2.new(1, 0, 1, 0)
	ConfirmFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	ConfirmFrame.BackgroundTransparency = 0.3
	ConfirmFrame.Visible = false
	ConfirmFrame.ZIndex = 10
	ConfirmFrame.Parent = MainFrame

	local DialogBox = Instance.new("Frame")
	DialogBox.Size = UDim2.new(0, 280, 0, 140)
	DialogBox.Position = UDim2.new(0.5, -140, 0.5, -70)
	DialogBox.BackgroundColor3 = Color3.fromRGB(20, 5, 5)
	DialogBox.ZIndex = 11
	DialogBox.Parent = ConfirmFrame

	local DialogStroke = Instance.new("UIStroke")
	DialogStroke.Color = Color3.fromRGB(180, 0, 0)
	DialogStroke.Thickness = 2
	DialogStroke.Parent = DialogBox

	local DialogTxt = Instance.new("TextLabel")
	DialogTxt.Size = UDim2.new(1, -20, 0, 50)
	DialogTxt.Position = UDim2.new(0, 10, 0, 15)
	DialogTxt.BackgroundTransparency = 1
	DialogTxt.Text = "Are you sure you want to close & unload the script?"
	DialogTxt.Font = Enum.Font.SourceSansBold
	DialogTxt.TextSize = 16
	DialogTxt.TextColor3 = Color3.fromRGB(220, 220, 220)
	DialogTxt.TextWrapped = true
	DialogTxt.ZIndex = 12
	DialogTxt.Parent = DialogBox

	local YesBtn = Instance.new("TextButton")
	YesBtn.Size = UDim2.new(0, 100, 0, 32)
	YesBtn.Position = UDim2.new(0.1, 0, 0.65, 0)
	YesBtn.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
	YesBtn.Text = "YES"
	YesBtn.Font = Enum.Font.Creepster
	YesBtn.TextSize = 18
	YesBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	YesBtn.ZIndex = 12
	YesBtn.Parent = DialogBox

	local NoBtn = Instance.new("TextButton")
	NoBtn.Size = UDim2.new(0, 100, 0, 32)
	NoBtn.Position = UDim2.new(0.55, 0, 0.65, 0)
	NoBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	NoBtn.Text = "NO"
	NoBtn.Font = Enum.Font.SourceSansBold
	NoBtn.TextSize = 16
	NoBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	NoBtn.ZIndex = 12
	NoBtn.Parent = DialogBox

	CloseBtn.MouseButton1Click:Connect(function()
		PlaySound()
		ConfirmFrame.Visible = true
	end)

	YesBtn.MouseButton1Click:Connect(function()
		PlaySound()
		ScreenGui:Destroy()
	end)

	NoBtn.MouseButton1Click:Connect(function()
		PlaySound()
		ConfirmFrame.Visible = false
	end)

	local minimized = false
	MinimizeBtn.MouseButton1Click:Connect(function()
		PlaySound()
		minimized = not minimized
		for _, child in ipairs(MainFrame:GetChildren()) do
			if child ~= Header and not child:IsA("UIStroke") and not child:IsA("Frame") then
				child.Visible = not minimized
			end
		end
		MainFrame.Size = minimized and UDim2.new(WindowSize.X.Scale, WindowSize.X.Offset, 0, 50) or WindowSize
	end)

	-- Tab System Initialization
	local TabBar = Instance.new("ScrollingFrame")
	TabBar.Name = "TabBar"
	TabBar.Size = UDim2.new(1, -16, 0, 35)
	TabBar.Position = UDim2.new(0, 8, 0, 55)
	TabBar.BackgroundTransparency = 1
	TabBar.CanvasSize = UDim2.new(0, 0, 0, 0)
	TabBar.ScrollBarThickness = 2
	TabBar.ScrollBarImageColor3 = Color3.fromRGB(150, 0, 0)
	TabBar.ScrollingDirection = Enum.ScrollingDirection.Horizontal
	TabBar.Parent = MainFrame

	local TabListLayout = Instance.new("UIListLayout")
	TabListLayout.FillDirection = Enum.FillDirection.Horizontal
	TabListLayout.Padding = UDim.new(0, 6)
	TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	TabListLayout.Parent = TabBar

	local ContainerArea = Instance.new("Frame")
	ContainerArea.Name = "ContainerArea"
	ContainerArea.Size = UDim2.new(1, -16, 1, -100)
	ContainerArea.Position = UDim2.new(0, 8, 0, 95)
	ContainerArea.BackgroundTransparency = 1
	ContainerArea.Parent = MainFrame

	local tabs = {}
	local activeTab = nil

	function Window:CreateTab(name)
		local TabBtn = Instance.new("TextButton")
		TabBtn.Size = UDim2.new(0, 100, 1, 0)
		TabBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
		TabBtn.BackgroundTransparency = 0.3
		TabBtn.Text = name
		TabBtn.Font = Enum.Font.Creepster
		TabBtn.TextSize = 16
		TabBtn.TextColor3 = Color3.fromRGB(160, 160, 160)
		TabBtn.BorderSizePixel = 0
		TabBtn.Parent = TabBar

		local Page = Instance.new("ScrollingFrame")
		Page.Name = name .. "Page"
		Page.Size = UDim2.new(1, 0, 1, 0)
		Page.BackgroundTransparency = 1
		Page.Visible = false
		Page.CanvasSize = UDim2.new(0, 0, 0, 0)
		Page.ScrollBarThickness = 4
		Page.ScrollBarImageColor3 = Color3.fromRGB(180, 0, 0)
		Page.Parent = ContainerArea

		local PageLayout = Instance.new("UIListLayout")
		PageLayout.Padding = UDim.new(0, 6)
		PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
		PageLayout.Parent = Page

		PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			Page.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 10)
		end)

		TabBar.CanvasSize = UDim2.new(0, TabListLayout.AbsoluteContentSize.X, 0, 0)

		local function Activate()
			for _, t in pairs(tabs) do
				t.Button.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
				t.Button.TextColor3 = Color3.fromRGB(160, 160, 160)
				t.Page.Visible = false
			end
			TabBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
			TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			Page.Visible = true
		end

		TabBtn.MouseButton1Click:Connect(function()
			PlaySound()
			Activate()
		end)

		if #tabs == 0 then
			Activate()
		end

		table.insert(tabs, {Button = TabBtn, Page = Page})

		local Elements = {}

		-- Button Component
		function Elements:CreateButton(btnText, callback)
			callback = callback or function() end
			local Btn = Instance.new("TextButton")
			Btn.Size = UDim2.new(1, -8, 0, 36)
			Btn.BackgroundColor3 = Color3.fromRGB(60, 5, 5)
			Btn.Text = btnText
			Btn.Font = Enum.Font.Creepster
			Btn.TextSize = 18
			Btn.TextColor3 = Color3.fromRGB(240, 240, 240)
			Btn.BorderSizePixel = 0
			Btn.Parent = Page

			local Stroke = Instance.new("UIStroke")
			Stroke.Color = Color3.fromRGB(120, 0, 0)
			Stroke.Thickness = 1
			Stroke.Parent = Btn

			Btn.MouseButton1Click:Connect(function()
				PlaySound("rbxassetid://6042053626", 1.1)
				callback()
			end)
		end

		-- Toggle Component
		function Elements:CreateToggle(toggleText, callback)
			callback = callback or function() end
			local state = false

			local Frame = Instance.new("Frame")
			Frame.Size = UDim2.new(1, -8, 0, 36)
			Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
			Frame.BorderSizePixel = 0
			Frame.Parent = Page

			local Label = Instance.new("TextLabel")
			Label.Size = UDim2.new(1, -70, 1, 0)
			Label.Position = UDim2.new(0, 10, 0, 0)
			Label.BackgroundTransparency = 1
			Label.Text = toggleText
			Label.Font = Enum.Font.SourceSansBold
			Label.TextSize = 16
			Label.TextColor3 = Color3.fromRGB(200, 200, 200)
			Label.TextXAlignment = Enum.TextXAlignment.Left
			Label.Parent = Frame

			local ToggleBtn = Instance.new("TextButton")
			ToggleBtn.Size = UDim2.new(0, 50, 0, 24)
			ToggleBtn.Position = UDim2.new(1, -58, 0.5, -12)
			ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
			ToggleBtn.Text = "OFF"
			ToggleBtn.Font = Enum.Font.SourceSansBold
			ToggleBtn.TextSize = 14
			ToggleBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
			ToggleBtn.BorderSizePixel = 0
			ToggleBtn.Parent = Frame

			ToggleBtn.MouseButton1Click:Connect(function()
				state = not state
				PlaySound()
				if state then
					ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
					ToggleBtn.Text = "ON"
					ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
				else
					ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
					ToggleBtn.Text = "OFF"
					ToggleBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
				end
				callback(state)
			end)
		end

		-- Slider Component
		function Elements:CreateSlider(sliderText, min, max, default, callback)
			callback = callback or function() end
			min = min or 0
			max = max or 100
			default = default or min

			local Frame = Instance.new("Frame")
			Frame.Size = UDim2.new(1, -8, 0, 48)
			Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
			Frame.BorderSizePixel = 0
			Frame.Parent = Page

			local Label = Instance.new("TextLabel")
			Label.Size = UDim2.new(0.7, 0, 0, 20)
			Label.Position = UDim2.new(0, 10, 0, 4)
			Label.BackgroundTransparency = 1
			Label.Text = sliderText
			Label.Font = Enum.Font.SourceSansBold
			Label.TextSize = 15
			Label.TextColor3 = Color3.fromRGB(200, 200, 200)
			Label.TextXAlignment = Enum.TextXAlignment.Left
			Label.Parent = Frame

			local ValLabel = Instance.new("TextLabel")
			ValLabel.Size = UDim2.new(0.25, 0, 0, 20)
			ValLabel.Position = UDim2.new(0.7, 0, 0, 4)
			ValLabel.BackgroundTransparency = 1
			ValLabel.Text = tostring(default)
			ValLabel.Font = Enum.Font.SourceSans
			ValLabel.TextSize = 15
			ValLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
			ValLabel.TextXAlignment = Enum.TextXAlignment.Right
			ValLabel.Parent = Frame

			local Track = Instance.new("Frame")
			Track.Size = UDim2.new(1, -20, 0, 10)
			Track.Position = UDim2.new(0, 10, 0, 28)
			Track.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
			Track.BorderSizePixel = 0
			Track.Parent = Frame

			local Fill = Instance.new("Frame")
			Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
			Fill.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
			Fill.BorderSizePixel = 0
			Fill.Parent = Track

			local isSliding = false
			local function UpdateSlider(input)
				local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
				local val = math.floor(min + ((max - min) * pos))
				Fill.Size = UDim2.new(pos, 0, 1, 0)
				ValLabel.Text = tostring(val)
				callback(val)
			end

			Track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					isSliding = true
					UpdateSlider(input)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					isSliding = false
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if isSliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					UpdateSlider(input)
				end
			end)
		end

		-- Dropdown Component
		function Elements:CreateDropdown(dropText, options, callback)
			callback = callback or function() end
			options = options or {}

			local Container = Instance.new("Frame")
			Container.Size = UDim2.new(1, -8, 0, 36)
			Container.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
			Container.ClipsDescendants = true
			Container.Parent = Page

			local MainBtn = Instance.new("TextButton")
			MainBtn.Size = UDim2.new(1, 0, 0, 36)
			MainBtn.BackgroundTransparency = 1
			MainBtn.Text = dropText .. "  ▼"
			MainBtn.Font = Enum.Font.SourceSansBold
			MainBtn.TextSize = 15
			MainBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
			MainBtn.Parent = Container

			local DropLayout = Instance.new("UIListLayout")
			DropLayout.SortOrder = Enum.SortOrder.LayoutOrder
			DropLayout.Parent = Container

			local expanded = false
			MainBtn.MouseButton1Click:Connect(function()
				PlaySound()
				expanded = not expanded
				Container.Size = expanded and UDim2.new(1, -8, 0, 36 + (#options * 28)) or UDim2.new(1, -8, 0, 36)
			end)

			for _, opt in ipairs(options) do
				local OptBtn = Instance.new("TextButton")
				OptBtn.Size = UDim2.new(1, 0, 0, 28)
				OptBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
				OptBtn.Text = tostring(opt)
				OptBtn.Font = Enum.Font.SourceSans
				OptBtn.TextSize = 14
				OptBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
				OptBtn.BorderSizePixel = 0
				OptBtn.Parent = Container

				OptBtn.MouseButton1Click:Connect(function()
					PlaySound()
					MainBtn.Text = dropText .. " : " .. tostring(opt)
					expanded = false
					Container.Size = UDim2.new(1, -8, 0, 36)
					callback(opt)
				end)
			end
		end

		-- TextBox Component
		function Elements:CreateTextBox(boxText, placeholder, callback)
			callback = callback or function() end

			local Frame = Instance.new("Frame")
			Frame.Size = UDim2.new(1, -8, 0, 36)
			Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
			Frame.BorderSizePixel = 0
			Frame.Parent = Page

			local Label = Instance.new("TextLabel")
			Label.Size = UDim2.new(0.4, 0, 1, 0)
			Label.Position = UDim2.new(0, 10, 0, 0)
			Label.BackgroundTransparency = 1
			Label.Text = boxText
			Label.Font = Enum.Font.SourceSansBold
			Label.TextSize = 15
			Label.TextColor3 = Color3.fromRGB(200, 200, 200)
			Label.TextXAlignment = Enum.TextXAlignment.Left
			Label.Parent = Frame

			local Input = Instance.new("TextBox")
			Input.Size = UDim2.new(0.55, -10, 0, 26)
			Input.Position = UDim2.new(0.45, 0, 0.5, -13)
			Input.BackgroundColor3 = Color3.fromRGB(5, 5, 5)
			Input.Text = ""
			Input.PlaceholderText = placeholder or "Type here..."
			Input.Font = Enum.Font.SourceSans
			Input.TextSize = 14
			Input.TextColor3 = Color3.fromRGB(255, 255, 255)
			Input.BorderSizePixel = 0
			Input.Parent = Frame

			local BoxStroke = Instance.new("UIStroke")
			BoxStroke.Color = Color3.fromRGB(100, 0, 0)
			BoxStroke.Thickness = 1
			BoxStroke.Parent = Input

			Input.FocusLost:Connect(function(enterPressed)
				callback(Input.Text, enterPressed)
			end)
		end

		return Elements
	end

	return Window
end

return ClassicoLib
